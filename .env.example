# Phase 02 operator configuration. Copy to .env and fill values locally.
# .env is ignored by Git. Never paste credentials into chat or logs.

# Supabase account > Access Tokens: personal access token for Management API.
# This is NOT a project publishable/anon or secret/service-role API key.
SUPABASE_ACCESS_TOKEN=

# Project Dashboard > Connect: direct or session-pooler PostgreSQL URL.
# Use port 5432 and database postgres. URL-encode special password characters.
# Supply only the explicitly isolated hosted test project's connection.
RADAR_DB_URL=

# Keep blank until db:plan succeeds and its migration plan has been reviewed.
RADAR_DB_PLAN_SHA256=

# Target identity/attestation is configured separately; see docs/DATABASE_WORKFLOW.md.
# RADAR_DB_TARGET_FILE=private/database-target.json
